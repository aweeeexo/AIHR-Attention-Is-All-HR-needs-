# Скопируйте в .env: cp .env.example .env  (файл .env в git не попадает)
# Пустое значение = значение по умолчанию. Без LLM_BASE_URL и LLM_MODEL — режим без LLM.

# --- LLM: любой OpenAI-совместимый API ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# ID проекта или каталога (нужен Yandex AI Studio). Пусто — не передаётся
LLM_PROJECT=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Параллельных запросов. Для провайдеров с одним потоком — 1
LLM_CONCURRENCY=4
# auto | json_schema | json_object. auto: json_schema, при отказе провайдера — json_object
LLM_STRUCTURED_MODE=auto
# Кэш ответов по хэшу запроса: повторный прогон на тех же файлах не ходит наружу (0 — выключить)
LLM_CACHE=1

# --- Эмбеддинги ---
# Сборка образа с sentence-transformers и torch (CPU): 1 — да, 0 — нет (быстрее и меньше)
WITH_EMBEDDINGS=0
# Пусто — эмбеддинги выключены
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# --- Прочее ---
MAX_FILE_MB=10
LOG_LEVEL=INFO
