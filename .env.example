# Скопируйте в .env: cp .env.example .env  (файл .env в git не попадает)
# Пустое значение = значение по умолчанию. Без LLM_BASE_URL и LLM_MODEL — режим без LLM.

# --- LLM: любой OpenAI-совместимый API ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Своя модель для отдельных шагов (D46), через запятую: extract/profile=<модель>,report/=<модель>
# Пример для Yandex AI Studio: LLM_MODEL=gpt://<каталог>/deepseek-v4-flash/latest,
# LLM_MODEL_ROUTES=extract/profile=gpt://<каталог>/yandexgpt-5.1/latest
LLM_MODEL_ROUTES=
# ID проекта или каталога (нужен Yandex AI Studio). Пусто — не передаётся
LLM_PROJECT=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Параллельных запросов. Для провайдеров с одним потоком — 1
LLM_CONCURRENCY=4
# Предел длины ответа модели; пусто — по умолчанию провайдера (у Yandex AI Studio мал: ставьте 8000)
LLM_MAX_TOKENS=
# auto | json_schema | json_object. auto: json_schema, при отказе провайдера — json_object
LLM_STRUCTURED_MODE=auto
# Кэш ответов по хэшу запроса: повторный прогон на тех же файлах не ходит наружу (0 — выключить)
LLM_CACHE=1

# --- Эмбеддинги ---
# Сборка образа с sentence-transformers и torch (CPU): 1 — да (по умолчанию, D42), 0 — только BM25:
# образ меньше на ~2,5 ГБ и собирается быстрее, полнота поиска ниже (eval/report.md)
WITH_EMBEDDINGS=1
# Пусто — эмбеддинги выключены
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# --- Прочее ---
MAX_FILE_MB=10
LOG_LEVEL=INFO
# «Сегодня» для расчёта стажа, ГГГГ-ММ. Пусто — текущий месяц
TODAY=

# --- Фронтенд ---
# Откуда браузер может ходить в API (через запятую; * — откуда угодно)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501
